# Development Dockerfile with hot reload support

FROM node:22.23.3-alpine3.24@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402

ARG APP_VERSION=
LABEL org.opencontainers.image.version="${APP_VERSION}"

WORKDIR /app

# Install dependencies for both frontend and backend
COPY src/backend/package*.json ./backend/
COPY src/frontend/package*.json ./frontend/
COPY VERSION /app/VERSION

# Install all dependencies (including dev dependencies)
RUN cd backend && npm ci --no-audit --no-fund
RUN cd frontend && npm ci --no-audit --no-fund

# Copy startup script
COPY start-dev.sh ./start-dev.sh
RUN sed -i 's/\r$//' ./start-dev.sh && chmod +x ./start-dev.sh

ENV APP_VERSION=$APP_VERSION
ENV VITE_APP_VERSION=$APP_VERSION

# Expose ports
EXPOSE 3000 3001

CMD ["./start-dev.sh"]
