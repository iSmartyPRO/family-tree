    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "ldapts": "^9.0.0",
    "libphonenumber-js": "^1.13.10",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.1.0",
