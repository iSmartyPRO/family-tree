# Docker
DOCKER_NAME=iapp-skeleton
DOCKER_PORT=8092
TZ=UTC

# Runtime
NODE_ENV=production
PORT=3001
# Public site URL. Use https://... in production so session cookies get the Secure flag.
FRONTEND_URL=http://localhost:8092
# Optional: force Secure cookies even if FRONTEND_URL is http
# COOKIE_SECURE=true

# PostgreSQL — can be filled via Setup Wizard on first run
POSTGRES_HOST=postgres-18
POSTGRES_PORT=5432
POSTGRES_DB=iapp_skeleton
POSTGRES_USER=iapp_skeleton
POSTGRES_PASSWORD=

# Auth — `make env` fills empty values with random secrets
JWT_SECRET=

# Reverse proxies in front of Express. The bundled nginx counts as 1. If the
# container sits behind another proxy (Traefik, NPM, Cloudflare), use 2 — otherwise
# every client looks like the proxy IP and lockouts / allow-lists misfire.
TRUST_PROXY_HOPS=1

# Written by the app once the setup wizard finishes. While true, /api/setup is
# closed even if the database is temporarily unreachable. Remove it only to
# deliberately re-run the wizard.
# SETUP_LOCKED=true

# Shared secret for the first-run wizard: /setup write endpoints require it
# (header X-Setup-Token, or the field in the wizard). `make env` fills it with a
# random value until setup is locked; leave empty only on a machine nobody else can reach.
SETUP_TOKEN=

# Uploaded avatars and logos
UPLOAD_DIR=/app/uploads

# Optional: full URL overrides POSTGRES_* above
# DATABASE_URL=postgresql://iapp_skeleton:change-me@postgres-18:5432/iapp_skeleton

# Dev compose only (Vite proxy target)
# VITE_API_URL=http://localhost:3021
